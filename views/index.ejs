<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anna Bot</title>
    <link rel="stylesheet" href="/assets/styles/style.css">
  </head>
  <body>
    <main>
      <section>
        <h1>What would you like to know about me? 🦥</h1>
        <% for (const message of messages) { %>
          <article class="<%= message.type%>">
            <p><%= message.text %></p>
          </article>
          <% } %>

        <!-- <div class="answer">Lorem ipsum dolor sit amet consectetur, adipisicing elit. Laborum optio beatae magnam vel culpa ipsum provident perferendis aut vero itaque consequuntur, sit minus tenetur dignissimos adipisci, necessitatibus facere architecto exercitationem.</div> -->

        <% if (error) { %>
          <p role ="alert"><%= error %></p>
        <% } %>
        
        <form method="POST" action="/ask">
          <label for="question">Your question here:</label>
          <div class="inputContainer">
            <input
              type="text"
              id="question"
              name="question"
              placeholder="Ask me anything right here"
            />
            <button type="submit">Send</button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
